// Configurazione per Cloudflare (Workers con file statici): dice a `npx wrangler deploy` di pubblicare la cartella dist costruita da `npm run build`.
// Il nome deve coincidere con il "Project name" scelto in Cloudflare. Non influisce su GitHub Pages ne' sull'app. Vedi SETUP.md, B6.
{
  "name": "todo",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
